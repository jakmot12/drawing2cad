# Skopiuj do .env i wpisz własny klucz. Plik .env nie trafia do repozytorium.

# Dostawca: deepseek (domyślny, tani) | openai_compat (dowolne API zgodne z OpenAI) | anthropic
LLM_PROVIDER=deepseek
# Model MUSI obsługiwać obrazy. Nazwy modeli DeepSeek się zmieniają,
# sprawdź aktualną na https://api-docs.deepseek.com
LLM_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# Dla openai_compat:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=

# Dla anthropic:
# ANTHROPIC_API_KEY=

# 0 = wysyłaj tylko liczby bez obrazu (wtedy każda część dostaje status NIEPEWNE)
LLM_VISION=1

# Limit tokenów odpowiedzi (modele rozumujące zużywają dużo na myślenie)
LLM_MAX_TOKENS=64000

# Koszty (USD za 1 mln tokenów: wejście, wejście z cache, wyjście); sprawdź cennik dostawcy
LLM_PRICE_IN=0.30
LLM_PRICE_IN_CACHED=0.006
LLM_PRICE_OUT=1.20
# Limit kosztu jednego przebiegu programu (USD); po przekroczeniu program przestaje pytać AI
LLM_MAX_COST=0.50
